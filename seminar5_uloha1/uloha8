WITH customer_first_purchase AS (
    SELECT 
        customer_id,
        MIN(DATE_TRUNC('month', order_date)) AS first_purchase_month
    FROM 
        orders
    GROUP BY 
        customer_id
),
june_2024_customers AS (
    SELECT 
        customer_id
    FROM 
        customer_first_purchase
    WHERE 
        first_purchase_month = '2024-06-01'
)
SELECT 
    COUNT(DISTINCT jc.customer_id) AS returned_customers_count
FROM 
    june_2024_customers jc
JOIN 
    orders o ON jc.customer_id = o.customer_id
WHERE 
    DATE_TRUNC('month', o.order_date) > '2024-06-01';